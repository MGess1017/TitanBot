# Discord bot token used by src/bot.ts
DISCORD_TOKEN=example-token-not-real

# Optional: register slash commands in one test server instantly.
# If omitted, commands are registered globally and can take time to appear.
DISCORD_GUILD_ID=your-discord-server-id

# Optional: channel ids used by health/mod logging.
DISCORD_ACTIVITY_CHANNEL_ID=
HEALTH_REPORT_CHANNEL_ID=

# Optional: send critical ops alerts.
OPS_ALERT_WEBHOOK_URL=

# Optional: override built-in guild-specific IDs for portability across servers.
TICKET_HANDLER_ROLE_ID=
TICKET_DEFAULT_CATEGORY_ID=
PERMANENT_TICKET_PANEL_CHANNEL_ID=
BOT_FEATURE_BRIEF_CHANNEL_ID=

# Optional: dedupe identical mutating commands in short bursts.
# Set to 0 to disable.
COMMAND_IDEMPOTENCY_WINDOW_MS=15000
