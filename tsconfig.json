{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/bot.ts",
    "src/utils.ts",
    "src/services/ticketOps.ts",
    "src/services/ticketTranscript.ts",
    "src/services/ticketState.ts",
    "src/services/ticketAnalytics.ts",
    "src/commands/ticketCommands.ts",
    "src/commands/moderationCommands.ts",
    "src/game/economy.ts",
    "src/game/raid.ts",
    "src/raid/domain.ts",
    "src/raid/simulator.ts"
  ],
  "exclude": ["node_modules", "**/*.spec.ts", "src/**/*.test.ts"]
}